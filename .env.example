# URL publique du site (sans slash final) — ex. https://www.noticeinternational.com
NEXT_PUBLIC_SITE_URL=

# Supabase (CMS, médiathèque, messages) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Destinataire des formulaires
CONTACT_TO=contact@noticeinternational.com

# Envoi des e-mails — au choix (le premier configuré est utilisé) :
# 1) Resend (recommandé) — https://resend.com
RESEND_API_KEY=
MAIL_FROM="Notice International <site@noticeinternational.com>"
# 2) SMTP de votre messagerie
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 3) Sans configuration : relais FormSubmit.co (un e-mail d'activation est envoyé une seule fois à CONTACT_TO)

# Assistant Écho — facultatif : sans clé, il répond avec son moteur local
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
